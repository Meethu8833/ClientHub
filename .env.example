# Copy to .env and fill in real values. NEVER commit .env itself.

# --- Django ---
DJANGO_SECRET_KEY=change-me-generate-with-get_random_secret_key
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (used by BOTH docker-compose's db service and Django) ---
POSTGRES_DB=clienthub
POSTGRES_USER=clienthub
POSTGRES_PASSWORD=change-me
# DB_HOST is 'localhost' from the host machine, 'db' when Django runs inside
# docker-compose. (No inline comments in .env files — parsers read them as values.)
DB_HOST=localhost
DB_PORT=5433

# --- CORS: the React dev server origin ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend base URL: password-reset / verification email links point here ---
FRONTEND_URL=http://localhost:5173

# --- Email (prod SMTP; dev uses the console backend automatically) ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=apikey-or-username
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ClientHub <no-reply@yourdomain.com>

# --- Document storage (prod only; see docs/documents-module.md) ---
# Option A (default): local disk + Nginx X-Accel. Set the internal location
# prefix that nginx.conf marks `internal;` — empty means Django streams (dev).
DOCUMENT_X_ACCEL_PREFIX=

# Option B: S3 (or any S3-compatible service). USE_S3=True switches the
# default storage backend — no code changes. Leave the keys empty on AWS to
# use the instance IAM role instead of static credentials.
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
