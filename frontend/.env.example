# Frontend environment variables.
# Vite only exposes variables prefixed with VITE_ to browser code
# (import.meta.env.VITE_...). NEVER put secrets here — everything in this
# file ends up inside the JavaScript bundle, readable by anyone.

# Base URL for the API. Leave unset in dev: the default "/api/v1" goes through
# the Vite proxy (vite.config.js) to Django on localhost:8000.
# VITE_API_BASE_URL=/api/v1
